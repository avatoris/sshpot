# Optional. Every setting below has a working default in docker-compose.yml,
# so this file is only a convenience - you can just as well pass variables
# inline: AVATORIS_API_KEY=your-key docker compose up -d
#
#   cp .env.example .env

# The only required setting. Free key at https://avatoris.com/login
AVATORIS_API_KEY=

# Public port of the decoy. Move your real sshd off 22 first (see README)
# if you want the honeypot on the standard port.
#HONEYPOT_PUBLIC_PORT=22

# Hostname the fake shell presents to attackers.
#HONEYPOT_HOSTNAME=prod-db-02

# Image tag to run. Pin a release instead of tracking latest, e.g. 1.2.3
#SSHPOT_TAG=latest

# Data sources.
#ENABLE_HONEYPOT_WATCH=true

# Watching the real host sshd is Linux-only and off by default. To enable it,
# point HOST_AUTH_LOG_PATH at the host's auth log (Debian/Ubuntu:
# /var/log/auth.log, RHEL/Fedora: /var/log/secure) and set GROUP_ADD_GID to a
# group that may read it (`getent group adm`).
#ENABLE_HOST_SSHD_WATCH=false
#HOST_AUTH_LOG_PATH=/var/log/auth.log
#GROUP_ADD_GID=4

# Avatoris accepts at most one report per target IP every 30 minutes; further
# attempts in that window are aggregated into the next report.
#REPORT_WINDOW_SECONDS=1800

# Stays under the API's 30 requests/minute limit with headroom.
#REPORTS_PER_MINUTE=25

# How often (seconds) to flush aggregated counts whose window has expired.
#FLUSH_INTERVAL_SECONDS=60
